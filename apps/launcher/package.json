{
  "name": "lazybuilder-tauri-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev:frontend": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "prepare:icons": "tauri icon src-tauri/app-icon.svg",
    "dev:app": "npm run prepare:icons && tauri dev",
    "build:frontend": "vite build",
    "build:app": "npm run prepare:icons && tauri build",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "check:rust": "npm run prepare:icons && cargo check --manifest-path src-tauri/Cargo.toml",
    "validate:quick": "npm run typecheck && npm run build:frontend && npm run check:rust"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.3.2",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^24.0.0",
    "svelte": "^5.56.8",
    "svelte-check": "^4.3.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.0.0",
    "vite": "^7.0.0"
  }
}
