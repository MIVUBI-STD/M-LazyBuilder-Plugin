<Window x:Class="HaloKaryaMedia.LazyBuilder.Desktop.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:HaloKaryaMedia.LazyBuilder.Desktop.Shell"
        xmlns:plugin="clr-namespace:HaloKaryaMedia.LazyBuilder.Desktop.Modules.PluginManager"
        xmlns:views="clr-namespace:HaloKaryaMedia.LazyBuilder.Desktop.Views"
        Title="LazyBuilder" Width="1120" Height="740" MinWidth="920" MinHeight="620"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate DataType="{x:Type shell:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type plugin:PluginsViewModel}">
            <views:PluginsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type shell:PlaceholderPageViewModel}">
            <views:PlaceholderView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Padding="18">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Top" Text="LazyBuilder" FontSize="22" FontWeight="SemiBold" Margin="4,0,0,24"/>
                <StackPanel>
                    <Button Content="Dashboard" Height="42" Margin="0,0,0,8" HorizontalContentAlignment="Left" Padding="14,0" Command="{Binding ShowDashboardCommand}"/>
                    <Button Content="Worlds" Height="42" Margin="0,0,0,8" HorizontalContentAlignment="Left" Padding="14,0" Command="{Binding ShowWorldsCommand}"/>
                    <Button Content="Plugins" Height="42" Margin="0,0,0,8" HorizontalContentAlignment="Left" Padding="14,0" Command="{Binding ShowPluginsCommand}"/>
                    <Button Content="Settings" Height="42" HorizontalContentAlignment="Left" Padding="14,0" Command="{Binding ShowSettingsCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ContentControl Grid.Column="1" Content="{Binding CurrentPage}"/>
    </Grid>
</Window>
