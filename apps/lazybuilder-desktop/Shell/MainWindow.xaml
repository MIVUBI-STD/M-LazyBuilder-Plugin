<Window x:Class="HaloKaryaMedia.LazyBuilder.Desktop.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LazyBuilder" Width="1040" Height="700" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Padding="18">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Top" Text="LazyBuilder" FontSize="22" FontWeight="SemiBold" Margin="4,0,0,24"/>
                <StackPanel>
                    <Button Content="Dashboard" Height="42" Margin="0,0,0,8" HorizontalContentAlignment="Left" Padding="14,0"/>
                    <Button Content="Worlds" Height="42" Margin="0,0,0,8" HorizontalContentAlignment="Left" Padding="14,0"/>
                    <Button Content="Plugins" Height="42" Margin="0,0,0,8" HorizontalContentAlignment="Left" Padding="14,0"/>
                    <Button Content="Settings" Height="42" HorizontalContentAlignment="Left" Padding="14,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="34">
                <TextBlock Text="Dashboard" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock Text="Server condition at a glance" Margin="0,6,0,28" Opacity="0.7"/>

                <UniformGrid Columns="2" Margin="0,0,0,22">
                    <Border Padding="20" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Server" FontSize="13" Opacity="0.7"/>
                            <TextBlock Text="{Binding ServerStatus}" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Padding="20" Margin="10,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Health" FontSize="13" Opacity="0.7"/>
                            <TextBlock Text="{Binding HealthStatus}" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <UniformGrid Columns="2" Margin="0,0,0,28">
                    <Border Padding="20" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="CPU Load" FontSize="13" Opacity="0.7"/>
                            <TextBlock Text="{Binding CpuText}" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Padding="20" Margin="10,0,0,0">
                        <StackPanel>
                            <TextBlock Text="RAM Usage" FontSize="13" Opacity="0.7"/>
                            <TextBlock Text="{Binding RamText}" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <TextBlock Text="{Binding LastError}" Visibility="{Binding HasError, Converter={x:Static BooleanToVisibilityConverter.Instance}}" Margin="0,0,0,16" TextWrapping="Wrap"/>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Start Server" Padding="18,10" Margin="0,0,10,0" Command="{Binding StartCommand}"/>
                    <Button Content="Stop" Padding="18,10" Margin="0,0,10,0" Command="{Binding StopCommand}"/>
                    <Button Content="Restart" Padding="18,10" Command="{Binding RestartCommand}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
