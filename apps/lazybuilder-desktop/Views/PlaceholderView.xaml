<UserControl x:Class="HaloKaryaMedia.LazyBuilder.Desktop.Views.PlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="34">
        <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding Description}" Margin="0,8,0,0" Opacity="0.7" TextWrapping="Wrap" MaxWidth="680" HorizontalAlignment="Left"/>
    </StackPanel>
</UserControl>
